; Wiesbaden Survivors — Godot 4 port
; Windows Desktop + Android. Keep this project self-contained under godot/.
config_version=5

[application]
config/name="Wiesbaden Survivors — Godot"
config/description="Datengesteuerter Survivors-Port der Wiesbaden Survivors für Windows und Android."
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")
config/icon="res://icon.png"
boot_splash/bg_color=Color(0.035, 0.055, 0.045, 1)
boot_splash/show_image=false

[autoload]
GameData="*res://scripts/game_data.gd"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=0

[input_devices]
pointing/emulate_touch_from_mouse=true
pointing/emulate_mouse_from_touch=true

[physics]
common/physics_ticks_per_second=60

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.035, 0.055, 0.045, 1)
textures/default_filters/use_nearest_mipmap_filter=false
textures/vram_compression/import_etc2_astc=true
textures/vram_compression/import_s3tc_bptc=true
