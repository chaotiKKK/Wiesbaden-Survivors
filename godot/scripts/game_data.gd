extends Node
## Read-only runtime view over the exported data.js registries.
## The JSON is generated by tools/export-godot-data.mjs and checked in with the
## Godot project so an exported Windows/Android build needs no browser files.

var loaded := false
var load_error := ""
var data: Dictionary = {}
var rules: Dictionary = {}
var wave_events: Dictionary = {}
var mods: Array = []
var run_upgrades: Array = []
var chars: Array = []
var weapons: Array = []
var items: Array = []
var enemies: Array = []
var base_enemies: Array = []
var bosses: Array = []
var arenas: Array = []
var dangers: Array = []

var char_by_id: Dictionary = {}
var weapon_by_id: Dictionary = {}
var item_by_id: Dictionary = {}
var run_upgrade_by_id: Dictionary = {}
var enemy_by_id: Dictionary = {}
var boss_by_id: Dictionary = {}
var arena_by_id: Dictionary = {}


func _ready() -> void:
	var text := FileAccess.get_file_as_string("res://data/game_data.json")
	if text.is_empty():
		load_error = "res://data/game_data.json fehlt; node tools/export-godot-data.mjs ausführen"
		push_error(load_error)
		return
	var parsed: Variant = JSON.parse_string(text)
	if typeof(parsed) != TYPE_DICTIONARY:
		load_error = "game_data.json ist kein Objekt"
		push_error(load_error)
		return
	data = parsed
	rules = data.get("rules", {})
	wave_events = data.get("waveEvents", {})
	mods = data.get("mods", [])
	run_upgrades = data.get("runUpgrades", [])
	chars = data.get("chars", [])
	weapons = data.get("weapons", [])
	items = data.get("items", [])
	enemies = data.get("enemies", [])
	base_enemies = data.get("baseEnemies", [])
	bosses = data.get("bosses", [])
	arenas = data.get("arenas", [])
	dangers = data.get("dangers", [])
	for row in chars:
		char_by_id[String(row.get("id", ""))] = row
	for row in weapons:
		weapon_by_id[String(row.get("id", ""))] = row
	for row in items:
		item_by_id[String(row.get("id", ""))] = row
	for row in run_upgrades:
		run_upgrade_by_id[String(row.get("id", ""))] = row
	for row in enemies:
		enemy_by_id[String(row.get("id", ""))] = row
	for row in bosses:
		boss_by_id[String(row.get("id", ""))] = row
	for row in arenas:
		arena_by_id[String(row.get("id", ""))] = row
	loaded = not chars.is_empty() and not weapons.is_empty()
	if not loaded:
		load_error = "Registries leer"
		push_error(load_error)


func color(value: Variant) -> Color:
	var s := String(value).strip_edges()
	if s.is_empty():
		return Color.WHITE
	if s.begins_with("#"):
		s = s.substr(1)
	if s.length() == 3:
		s = s[0] + s[0] + s[1] + s[1] + s[2] + s[2]
	if s.length() != 6 and s.length() != 8:
		return Color.WHITE
	return Color.html(s)


func num(dict: Dictionary, key: String, fallback: float = 0.0) -> float:
	var value: Variant = dict.get(key, fallback)
	if typeof(value) == TYPE_INT or typeof(value) == TYPE_FLOAT:
		return float(value)
	return fallback


func danger_value(index: int, key: String, fallback: float = 1.0) -> float:
	if dangers.is_empty():
		return fallback
	return num(dangers[clampi(index, 0, dangers.size() - 1)], key, fallback)


func weapon(id: String) -> Dictionary:
	return weapon_by_id.get(id, {})


func character(id: String) -> Dictionary:
	return char_by_id.get(id, {})


func item(id: String) -> Dictionary:
	return item_by_id.get(id, {})


func run_upgrade(id: String) -> Dictionary:
	return run_upgrade_by_id.get(id, {})


func arena(id: String) -> Dictionary:
	return arena_by_id.get(id, {})


func boss_for_wave(wave: int) -> Dictionary:
	if bosses.is_empty():
		return {}
	var index := (maxi(1, int(floor(float(wave) / 5.0))) - 1) % bosses.size()
	return bosses[index]


func pick_enemy(wave: int, rng: RandomNumberGenerator) -> Dictionary:
	var pool: Array = []
	var total := 0
	for row in enemies:
		var min_wave := int(row.get("minW", 1))
		if min_wave > wave or min_wave >= 999:
			continue
		# Campaign enemies without an authored weight still participate.
		var weight := maxi(1, int(row.get("w", 10)))
		pool.append({"row": row, "weight": weight})
		total += weight
	if pool.is_empty():
		return enemies[0] if not enemies.is_empty() else {}
	var pick := rng.randi_range(1, maxi(1, total))
	for entry in pool:
		pick -= int(entry.weight)
		if pick <= 0:
			return entry.row
	return pool[0].row


func random_weapon(rng: RandomNumberGenerator, allowed: Array = []) -> Dictionary:
	var pool: Array = []
	for row in weapons:
		if allowed.is_empty() or allowed.has(String(row.get("id", ""))):
			pool.append(row)
	if pool.is_empty():
		return {}
	return pool[rng.randi_range(0, pool.size() - 1)]


func random_item(rng: RandomNumberGenerator) -> Dictionary:
	if items.is_empty():
		return {}
	return items[rng.randi_range(0, items.size() - 1)]


func weapon_price(id: String, tier: int = 0) -> int:
	var def := weapon(id)
	var tiers: Array = def.get("tiers", [])
	if tiers.is_empty():
		return 20
	var t: Array = tiers[clampi(tier, 0, tiers.size() - 1)]
	return int(t[5]) if t.size() > 5 else 20
